# ==============================================================================
# i3wm CONFIGURATION FILE
# Optimized for Keyboard-Driven Productivity & Clean Portfolios
# Theme: Dracula (Official Spec) with i3-gaps enabled
# Reference: https://i3wm.org/docs/userguide.html#configuring
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Variables & Modifiers
# ------------------------------------------------------------------------------
# Set Modifier Key (Mod4 = Windows Key)
set $mod Mod4

# Set minimum geometry bounds for floating windows (width x height)
floating_minimum_size 300 x 200

# Set maximum geometry bounds for floating windows (width x height)
# Using -1 x -1 means unconstrained/no maximum limit (or set explicit bounds like 1600 x 900)
floating_maximum_size 1600 x 900

# ------------------------------------------------------------------------------
# Workspace Default Split Orientation
# Options: horizontal | vertical | auto
# ------------------------------------------------------------------------------
# - horizontal: First split will place windows side-by-side (left/right)
# - vertical:   First split will place windows stacked top/bottom
# - auto:       Determines orientation based on monitor aspect ratio (horizontal on landscape, vertical on portrait)
default_orientation horizontal

# ------------------------------------------------------------------------------
# Default Layout Mode for New Containers
# Options: default | stacking | tabbed
# ------------------------------------------------------------------------------
# - default: Standard tiling layout (splits containers horizontally/vertically)
# - stacking: Stacks containers vertically, showing titlebars in a list
# - tabbed: Arranges containers into horizontal tabs (browser-style)
workspace_layout default

# ------------------------------------------------------------------------------
# Window Title Text Alignment
# Options: left | center | right
# ------------------------------------------------------------------------------
# - left:   Aligns title text to the left side of the titlebar (default)
# - center: Centers title text horizontally within the titlebar
# - right:  Aligns title text to the right side of the titlebar
title_align center

# ------------------------------------------------------------------------------
# Screen Edge Border Suppression
# Options: none | vertical | horizontal | both | smart | smart_no_gaps
# ------------------------------------------------------------------------------
# - none:           Show borders on all screen edges (default)
# - vertical:       Hide left and right borders touching screen edges
# - horizontal:     Hide top and bottom borders touching screen edges
# - both:           Hide borders on all four screen edges
# - smart:          Hide borders on screen edges only if a single container is present
# - smart_no_gaps:  Hide borders on screen edges if single container AND gaps are 0
hide_edge_borders smart

# ------------------------------------------------------------------------------
# Default Window Border Styles
# Syntax: default_border normal|pixel|none [<width>]
# Syntax: default_floating_border normal|pixel|none [<width>]
# ------------------------------------------------------------------------------
# Default border style for new tiled containers
default_border pixel 2

# Default border style for new floating windows
default_floating_border normal 2

# ------------------------------------------------------------------------------
# Mouse Focus Behavior
# Options: yes | no | always
# ------------------------------------------------------------------------------
# - yes:    Focus follows mouse movement across window boundaries (default)
# - no:     Focus requires an explicit mouse click or keyboard action
# - always: Focus follows mouse movement even across different workspaces/monitors
focus_follows_mouse yes

# ------------------------------------------------------------------------------
# Mouse Cursor Warping Behavior
# Options: output | none
# ------------------------------------------------------------------------------
# - output: Warps mouse cursor to center of newly focused monitor/output (default)
# - none:   Prevents mouse cursor from ever moving automatically
mouse_warping output

# ------------------------------------------------------------------------------
# Popups During Fullscreen Mode
# Options: smart | ignore | leave_fullscreen
# ------------------------------------------------------------------------------
# - smart:            Show popups if they belong to the current fullscreen window (default)
# - ignore:           Suppress all popups while fullscreen mode is active
# - leave_fullscreen: Automatically exit fullscreen mode when any popup appears
popup_during_fullscreen smart

# ------------------------------------------------------------------------------
# Focus Wrapping Behavior
# Options: yes | no | force | workspace
# ------------------------------------------------------------------------------
# - yes:       Wrap focus within current container boundary (default)
# - no:        Disable focus wrapping entirely (stops at outer edges)
# - force:     Force focus wrapping across parent container boundaries
# - workspace: Allow wrapping only across workspace boundaries
focus_wrapping yes

# ------------------------------------------------------------------------------
# Force Xinerama Multi-Monitor API
# Options: true | false
# ------------------------------------------------------------------------------
# - false: Use modern RandR API for multi-monitor handling (default)
# - true:  Force legacy Xinerama API (use only if RandR fails/causes glitches)
force_xinerama false

# ------------------------------------------------------------------------------
# Automatic Back-and-Forth Workspace Switching
# Options: yes | no
# ------------------------------------------------------------------------------
# - yes: Switching to current workspace toggles back to previous workspace
# - no:  Switching to current workspace does nothing (default)
workspace_auto_back_and_forth yes

# ------------------------------------------------------------------------------
# Delay Urgency Hint Reset on Workspace Change
# Syntax: force_display_urgency_hint <ms>
# ------------------------------------------------------------------------------
# Set duration in milliseconds to keep the urgency hint visible on workspace switch
# Example: 500ms delay before clearing urgency indicator
force_display_urgency_hint 500 ms

# ------------------------------------------------------------------------------
# Window Focus Activation Behavior
# Options: smart | urgent | focus | none
# ------------------------------------------------------------------------------
# - smart:  Grant focus if on active workspace; otherwise set urgency hint (default)
# - urgent: Always mark requesting window as urgent without changing focus
# - focus:  Always switch focus (and jump workspace) to the requesting window
# - none:   Ignore focus activation requests completely
focus_on_window_activation focus

# ------------------------------------------------------------------------------
# Display Window Marks in Titlebars
# Options: yes | no
# ------------------------------------------------------------------------------
# - yes: Draw custom mark identifiers in window titlebars (default)
# - no:  Hide custom mark identifiers from window decorations
show_marks yes

# Applications & Launchers
set $terminal   kitty
set $launcher1  dmenu_run -fn 'Lilex Nerd Font Mono-10' -nb '#282a36' -nf '#f8f8f2' -sb '#bd93f9' -sf '#282a36'
set $launcher2  rofi -show drun -theme ~/.config/rofi/config.rasi

# Dracula Color Palette
set $dracula-bg           #282a36
set $dracula-curnt-line   #44475a
set $dracula-fg           #f8f8f2
set $dracula-comment      #6272a4
set $dracula-cyan         #8be9fd
set $dracula-green        #50fa7b
set $dracula-orange       #ffb86c
set $dracula-pink         #ff79c6
set $dracula-purple       #bd93f9
set $dracula-red          #ff5555
set $dracula-yellow       #f1fa8c

# ------------------------------------------------------------------------------
# 2. Fonts & Visuals (Including i3-gaps Settings)
# ------------------------------------------------------------------------------
# Font for window titles and bar
font pango:Lilex Nerd Font 10

# --- i3-gaps Configuration ---
# Inner gaps: Space between windows
gaps inner 25

# Outer gaps: Space between windows and screen edges
gaps outer -5

# Only show borders if there is more than one window on a workspace
#smart_borders on
# ------------------------------

# Window Colors (Dracula Theme Spec)
# class                 border                  background              text                indicator       child_border
client.focused          $dracula-purple         $dracula-purple         $dracula-bg         $dracula-pink   $dracula-purple
client.focused_inactive $dracula-curnt-line     $dracula-curnt-line     $dracula-fg         $dracula-purple $dracula-curnt-line
client.unfocused        $dracula-bg             $dracula-bg             $dracula-comment    $dracula-purple $dracula-bg
client.urgent           $dracula-red            $dracula-red            $dracula-fg         $dracula-purple $dracula-red

# ------------------------------------------------------------------------------
# 3. Keybindings: Core Operations
# ------------------------------------------------------------------------------
# Start terminal
bindsym $mod+Return exec $terminal

# Special Floating Terminal (Launches with a unique X11 window class)
bindsym $mod+Shift+Return exec --no-startup-id kitty --class kitty-floating

# Kill focused window
bindsym $mod+Shift+q kill

# Launchers (Mod+d for Rofi, Mod+Shift+d for Dmenu)
bindsym $mod+d exec --no-startup-id $launcher2
bindsym $mod+Shift+d exec --no-startup-id $launcher1

# Reload the configuration file
bindsym $mod+Shift+c reload

# Restart i3 inplace (preserves your layout/session)
bindsym $mod+Shift+r restart

# Exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# Screen Brightness Controls (Requires brightnessctl or light)
bindsym XF86MonBrightnessUp exec --no-startup-id "brightnessctl set +10% && dunstify -a 'System' -h string:x-dunst-stack-tag:brightness -h int:value:$(brightnessctl -m | cut -d, -f4 | tr -d '%') '󰖨 Brightness' -i notification-display-brightness"
bindsym XF86MonBrightnessDown exec --no-startup-id "brightnessctl set 10%- && dunstify -a 'System' -h string:x-dunst-stack-tag:brightness -h int:value:$(brightnessctl -m | cut -d, -f4 | tr -d '%') '󰖨 Brightness' -i notification-display-brightness"

# Audio Volume Controls (Native Pipewire / WirePlumber)
# Raise volume (capped at 100%)
bindsym XF86AudioRaiseVolume exec --no-startup-id "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ && dunstify -a 'System' -h string:x-dunst-stack-tag:volume -h int:value:$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $2*100}') '󰕾 Audio Volume'"

# Lower volume
bindsym XF86AudioLowerVolume exec --no-startup-id "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && dunstify -a 'System' -h string:x-dunst-stack-tag:volume -h int:value:$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $2*100}') '󰕾 Audio Volume'"

# Toggle mute
bindsym XF86AudioMute exec --no-startup-id "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && dunstify -a 'System' -h string:x-dunst-stack-tag:volume '󰝟 Audio Mute Toggle'"

# Microphone Volume Controls (Native Pipewire / WirePlumber)
# Raise microphone volume (capped at 100%)
bindsym $mod+XF86AudioRaiseVolume exec --no-startup-id "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+ && dunstify -a 'System' -h string:x-dunst-stack-tag:mic -h int:value:$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | awk '{print $2*100}') '󰍬 Mic Volume'"

# Lower microphone volume
bindsym $mod+XF86AudioLowerVolume exec --no-startup-id "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%- && dunstify -a 'System' -h string:x-dunst-stack-tag:mic -h int:value:$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | awk '{print $2*100}') '󰍬 Mic Volume'"

# Toggle microphone mute
bindsym $mod+XF86AudioMute exec --no-startup-id "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && dunstify -a 'System' -h string:x-dunst-stack-tag:mic '󰍭 Mic Mute Toggle'"

# Manual lock trigger using Mod+Shift+x with Dark+Blur effects and instant screen-off
bindsym $mod+Shift+x exec --no-startup-id betterlockscreen -l dimblur --off 5

# ------------------------------------------------------------------------------
# 4. Keybindings: Navigation & Layouts
# ------------------------------------------------------------------------------

# Mouse Bindings
# Mod+Left Click: Drag floating windows to move them (Default i3 behavior)
# Mod+Right Click: Drag to resize windows from any edge (Default i3 behavior)
floating_modifier $mod

# Mod+Middle Click: Toggle window state between floating and tiling seamlessly
# bindsym --whole-window $mod+button2 floating toggle
bindsym --whole-window $mod+button2 kill

# Change focus (Vim-style navigation)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Toggle split direction (Horizontal <-> Vertical) using a single keybinding
bindsym $mod+q split toggle

# Enter fullscreen mode
bindsym $mod+f fullscreen toggle

# Change container layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# Change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# ------------------------------------------------------------------------------
# 5. Workspaces Configuration
# ------------------------------------------------------------------------------
# Define Workspace Names with Nerd Font Glyphs
set $ws1 "1:󰆍 "
set $ws2 "2:󰖟 "
set $ws3 "3:󰲋 "
set $ws4 "4:󰭹 "
set $ws5 "5:󰝚 "

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

# Cycle through workspaces sequentially (Left / Right)
bindsym $mod+Prior workspace prev
bindsym $mod+Next workspace next

# Toggle back and forth between the two most recently focused workspaces
bindsym $mod+Tab workspace back_and_forth

# ------------------------------------------------------------------------------
# 6. Resizing Mode
# ------------------------------------------------------------------------------
mode "Resize" {
        bindsym h resize shrink width 5 px or 5 ppt
        bindsym j resize grow height 5 px or 5 ppt
        bindsym k resize shrink height 5 px or 5 ppt
        bindsym l resize grow width 5 px or 5 ppt

        # Back to normal mode
        bindsym Return mode "default"
        bindsym Escape mode "default"
}
bindsym $mod+r mode "Resize"

# ------------------------------------------------------------------------------
# 7. Status Bar Configuration (Implementing Chapter 5 Opsi Lengkap)
# ------------------------------------------------------------------------------
bar {
        # 5.1 i3status command invocation
        status_command i3status --config ~/.config/i3/i3status/config
        
        # 5.2 Bar positioning (top or bottom)
        position top
        
        # 5.3 Display mode (dock, hide, or invisible)
        mode dock
        
        # 5.4 Modifier key to toggle bar visibility when hidden (e.g., Mod4)
        modifier Mod4
        
        # 5.5 Monitor/Output selection (uncomment to bind to specific monitors)
        # output primary
        
        # 5.6 Workspace interactive buttons toggle
        workspace_buttons yes
        
        # 5.7 Remove number prefixes from workspace names
        strip_workspace_numbers yes
        strip_workspace_name yes
        
        # 5.8 Binding mode indicator toggle on the bar
        binding_mode_indicator yes
        
        # 5.9 Font configuration and height/vertical padding adjustments
        font pango:Lilex Nerd Font 10
        workspace_min_width 50
        padding 3px 0
        tray_padding 7px

        # 5.10 Disable clicking on workspace buttons
        # bindsym button1 nop
        bindsym button2 nop
        bindsym button3 nop
        bindsym button4 nop
        bindsym button5 nop
        bindsym button6 nop
        bindsym button7 nop

        # 5.11 Detailed color palette definitions (Dracula Spec Integration)
        colors {
                background $dracula-bg
                statusline $dracula-fg
                separator  $dracula-comment

                # class            border                 background             text
                focused_workspace  $dracula-purple        $dracula-purple        $dracula-bg
                active_workspace   $dracula-curnt-line    $dracula-curnt-line    $dracula-fg
                inactive_workspace $dracula-bg            $dracula-bg            $dracula-comment
                urgent_workspace   $dracula-red           $dracula-red           $dracula-fg
                binding_mode       $dracula-red           $dracula-red           $dracula-bg
        }
}

# ------------------------------------------------------------------------------
# 8. Autostart Applications
# ------------------------------------------------------------------------------
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id nm-applet
exec --no-startup-id dunst
exec --no-startup-id picom -b
exec --no-startup-id feh --bg-fill ~/.config/i3/wallpapers/linux-arch-dark.jpg

# Power Management: Monitor battery with upower and alert via notifications
exec_always --no-startup-id poweralertd

# Idle Management: xidlehook configuration
# 300s (5m)  : Screen off
# 900s (15m) : Lock screen
# 1800s (30m): Suspend system
exec_always --no-startup-id xidlehook \
  --not-when-fullscreen \
  --not-when-audio \
  --timer 300 'xset dpms force off' '' \
  --timer 600 'betterlockscreen -l dimblur --off 1' '' \
  --timer 900 'systemctl suspend' ''

# ------------------------------------------------------------------------------
# 9. Window Rules & Custom Target Routings
# ------------------------------------------------------------------------------

# --- 9.1 Workspace Layout Enforcers ---
for_window [workspace=$ws1] layout default
for_window [workspace=$ws2] layout tabbed
for_window [workspace=$ws3] layout tabbed

# --- 9.2 Comprehensive i3wm window_type Specifications ---
# Base window states
for_window [window_type="normal"] floating disable
for_window [window_type="dialog"] floating enable, resize set 40 ppt 40 ppt, move position center
for_window [window_type="utility" class="^(?!(firefox|zen)$)"] floating enable, resize set 30 ppt 30 ppt, move position center
for_window [window_type="toolbar"] floating enable, resize set 30 ppt 20 ppt, move position center
for_window [window_type="splash"] floating enable, resize set 30 ppt 30 ppt, move position center

# Unmanaged / Transient UI elements (Ensure clean borderless render)
for_window [window_type="menu"] floating enable, border none
for_window [window_type="dropdown_menu"] floating enable, border none
for_window [window_type="popup_menu"] floating enable, border none
for_window [window_type="tooltip"] floating enable, border none
for_window [window_type="notification"] floating enable, border none

# --- 9.3 Standard X11 window_role Specifications ---
for_window [window_role="pop-up"] floating enable, resize set 40 ppt 40 ppt, move position center
for_window [window_role="Preferences"] floating enable, resize set 40 ppt 40 ppt, move position center
for_window [window_role="setup"] floating enable, resize set 40 ppt 40 ppt, move position center
for_window [window_role="task_manager"] floating enable, resize set 40 ppt 50 ppt, move position center
for_window [window_role="progress_dialog"] floating enable, resize set 30 ppt 15 ppt, move position center
for_window [window_role="about"] floating enable, resize set 30 ppt 30 ppt, move position center

# --- 9.4 Terminal Rules ---
for_window [class="kitty-floating"] floating enable, resize set 50 ppt 50 ppt, move position center

# --- 9.5 Web Browsers Rules (Firefox & Zen) ---
# Places Manager (Bookmarks & History)
for_window [class="(?i)(firefox|zen)" instance="^Places$"] floating enable, resize set 50 ppt 50 ppt, move position center

# Dynamic Torrent Popups
for_window [class="(?i)(firefox|zen)" instance="^Navigator$" title="^Torrents.*"] floating enable, resize set 33 ppt 50 ppt, move position center

# Consolidated Picture-in-Picture Overlays (Overrides utility/dialog position seamlessly)
for_window [class="(?i)(firefox|zen)" title="^Picture-in-Picture$"] floating enable, resize set 25 ppt 25 ppt, move absolute position 74 ppt 73 ppt, sticky enable
for_window [window_role="PictureInPicture"] floating enable, resize set 25 ppt 25 ppt, move absolute position 74 ppt 73 ppt, sticky enable
no_focus [class="(?i)(firefox|zen)" title="^Picture-in-Picture$"]

# --- 9.6 Media Players (MPV) ---
for_window [class="^mpv$" window_role="^mpv$"] floating enable, resize set 25 ppt 25 ppt, move absolute position 74 ppt 73 ppt, sticky enable
no_focus [class="^mpv$" window_role="^mpv$"]
for_window [class="^mpv$" window_role="^mpv-fullscreen$"] floating disable, focus

# --- 9.7 Download Managers & Clients ---
# Xtreme Download Manager (XDM)
for_window [class="^Xdm-app$" title="^Xtreme Download Manager$"] floating enable, resize set 75 ppt 75 ppt, move position center
for_window [class="^Xdm-app$" title="^New Download$"] floating enable, resize set 30 ppt 15 ppt, move position center
for_window [class="^Xdm-app$" title="^Settings$"] floating enable, resize set 50 ppt 50 ppt, move position center

# Transmission-GTK (Fixed Case-Sensitivity Match)
for_window [class="(?i)transmission-gtk"] floating enable, resize set 30 ppt 60 ppt, move position center

# --- 9.8 Workspace Target Assignments ---
assign [class="^kitty$"] $ws1
assign [class="^Google-chrome$"] $ws2
assign [class="^firefox$"] $ws2
assign [class="^zen$"] $ws2
assign [class="^Pcmanfm$"] $ws3
assign [class="^pcmanfm-qt$"] $ws3
